# Copy to .env.local. With nothing set, the app runs on the rules engine and the browser's built-in voice.

# --- Model (required at the event): Nicrron, OpenAI-compatible ---
# The key alone is enough: base URL defaults to https://api.nicrron.ai/v1 and the model to anthropic/claude-sonnet-5-5.
NICRRON_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5-5
# Any other OpenAI-compatible endpoint instead:
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_CONCURRENCY=6

# --- PRISM by Block Convey (required at the event) ---
# Settings → Project for the project id; API keys page for an "ingest" key (shown once).
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
# PRISMTRACE_HOST=https://api.prism.blockconvey.com
# If set, /api/agent requires this value in the X-Prism-Test-Key header (except from the app's own page).
# PRISM_TEST_KEY=

# --- ElevenLabs voice for the callback call (optional) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Local JSONL copy of every investigation.
# TRACE_FILE=traces.jsonl
